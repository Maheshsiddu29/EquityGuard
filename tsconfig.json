{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "scripts/devnet/**/*.ts", "scripts/jupiter/**/*.ts", "scripts/observation/**/*.ts", "scripts/demo/**/*.ts", "scripts/replay/**/*.ts", "apps/reference/build/**/*.ts", "apps/reference/test/**/*.ts", "apps/example-jupiter-protected/src/**/*.ts", "apps/example-jupiter-protected/test/**/*.ts"]
}
