{
  "name": "equityguard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/guard-client",
    "packages/jupiter"
  ],
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
