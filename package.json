    "jupiter:compose-mainnet": "node scripts/jupiter/compose-mainnet.ts"
  },
  "dependencies": {
    "@solana-program/system": "0.14.1",
    "@solana-program/token-2022": "0.17.0",
    "@solana/kit": "8.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "7.0.2"
  }
}
