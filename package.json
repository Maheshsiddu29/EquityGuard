{
  "name": "equityguard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/guard-client",
    "packages/jupiter",
    "packages/representation-state"
  ],
  "scripts": {
    "typecheck": "tsc --project tsconfig.json && tsc --project apps/reference/tsconfig.json --noEmit && tsc --project apps/devnet-wallet-demo/tsconfig.json --noEmit",
    "test": "node --test \"packages/**/*.test.ts\" \"scripts/**/*.test.ts\" \"scripts/evidence/*.test.mjs\" \"apps/**/*.test.ts\"",
    "app:build": "node apps/reference/build/build.ts",
    "app:serve": "node apps/reference/build/serve.ts",
    "wallet-demo:build": "npx tsx apps/devnet-wallet-demo/build/build.ts",
    "wallet-demo:serve": "npx tsx apps/devnet-wallet-demo/build/serve.ts",
    "devnet": "node scripts/devnet/cli.ts",
    "devnet:guard-v2-proof": "node scripts/devnet/guard-v2-live-proof.ts",
    "observation:decode": "node scripts/observation/decode-capture.ts",
    "observation:events": "node scripts/observation/detect-events.ts",
    "observation:snapshot": "node scripts/observation/snapshot-capture.ts",
    "observation:timeline": "node scripts/observation/timeline.ts",
    "observation:extract": "node scripts/observation/extract-window.ts",
    "observation:snapshot-xstocks-api": "node scripts/observation/snapshot-xstocks-api.ts",
    "observation:correlate-kox": "node scripts/observation/correlate-kox.ts",
    "observation:curate": "node scripts/observation/curate-observations.ts",
    "demo:equityguard": "node scripts/demo/equityguard-demo.ts",
    "research:jupiter-routes": "node scripts/research/jupiter-route-matrix.ts",
    "research:jupiter-fields": "node scripts/research/jupiter-field-probe.ts"
  },
  "dependencies": {
    "@solana-program/system": "0.14.1",
    "@solana-program/token-2022": "0.17.0",
    "@solana/kit": "8.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "7.0.2"
  }
}
