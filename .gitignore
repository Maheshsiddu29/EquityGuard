# Rust / Solana build output
/target/
**/*.so
test-ledger/

# Keypairs and secrets: never commit. Program and wallet keypairs belong
# outside the repository; these patterns are a backstop.
*keypair*.json
id.json
wallet*.json
.env
.env.*
!.env.example

# Node
node_modules/

# Reference app build output
apps/reference/dist/
apps/devnet-wallet-demo/dist/

# Python fixture generators
__pycache__/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local documentation / development notes: only the root README is public
*.md
!/README.md

# Evidence is local by default
evidence/**

# Local analysis snapshots and extracted windows (INV-CAP-01 copies)
tmp/
